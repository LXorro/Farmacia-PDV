<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>ConfigurarBdDialog</class>
 <widget class="QDialog" name="ConfigurarBdDialog">
  <property name="geometry">
   <rect><x>0</x><y>0</y><width>520</width><height>560</height></rect>
  </property>
  <property name="windowTitle"><string>Configurar base de datos — Farmacia</string></property>
  <layout class="QVBoxLayout" name="verticalLayout">
   <item>
    <widget class="QLabel" name="labelInfo">
     <property name="text"><string>Es la primera vez que se usa la aplicación en este equipo, o la base de datos no está lista. Indica una cuenta administradora del MariaDB de este equipo (normalmente «root»): se usará una sola vez para crear la base «farmacia» y un usuario propio de la aplicación. Si lo conectas con un central, también se configura la replicación. Las contraseñas de administración y de registro no se guardan.</string></property>
     <property name="wordWrap"><bool>true</bool></property>
    </widget>
   </item>
   <item>
    <layout class="QFormLayout" name="formLayout">
     <item row="0" column="0">
      <widget class="QLabel" name="labelPuerto"><property name="text"><string>Puerto de MariaDB:</string></property></widget>
     </item>
     <item row="0" column="1">
      <widget class="QSpinBox" name="spinPuerto">
       <property name="minimum"><number>1</number></property>
       <property name="maximum"><number>65535</number></property>
      </widget>
     </item>
     <item row="1" column="0">
      <widget class="QLabel" name="labelUsuarioAdmin"><property name="text"><string>Administrador:</string></property></widget>
     </item>
     <item row="1" column="1">
      <widget class="QLineEdit" name="lineUsuarioAdmin">
       <property name="text"><string>root</string></property>
      </widget>
     </item>
     <item row="2" column="0">
      <widget class="QLabel" name="labelContrasenaAdmin"><property name="text"><string>Contraseña:</string></property></widget>
     </item>
     <item row="2" column="1">
      <widget class="QLineEdit" name="lineContrasenaAdmin">
       <property name="echoMode"><enum>QLineEdit::Password</enum></property>
      </widget>
     </item>
     <item row="3" column="0" colspan="2">
      <widget class="QCheckBox" name="checkCentral">
       <property name="text"><string>Conectar este equipo con un central (replicación automática)</string></property>
       <property name="checked"><bool>true</bool></property>
      </widget>
     </item>
     <item row="4" column="0">
      <widget class="QLabel" name="labelHostCentral"><property name="text"><string>Dirección del central:</string></property></widget>
     </item>
     <item row="4" column="1">
      <widget class="QLineEdit" name="lineHostCentral"/>
     </item>
     <item row="5" column="0">
      <widget class="QLabel" name="labelPuertoCentral"><property name="text"><string>Puerto del central:</string></property></widget>
     </item>
     <item row="5" column="1">
      <widget class="QSpinBox" name="spinPuertoCentral">
       <property name="minimum"><number>1</number></property>
       <property name="maximum"><number>65535</number></property>
      </widget>
     </item>
     <item row="6" column="0">
      <widget class="QLabel" name="labelUsuarioRegistro"><property name="text"><string>Cuenta de registro:</string></property></widget>
     </item>
     <item row="6" column="1">
      <widget class="QLineEdit" name="lineUsuarioRegistro">
       <property name="text"><string>farmacia_registro</string></property>
      </widget>
     </item>
     <item row="7" column="0">
      <widget class="QLabel" name="labelContrasenaRegistro"><property name="text"><string>Contraseña de registro:</string></property></widget>
     </item>
     <item row="7" column="1">
      <widget class="QLineEdit" name="lineContrasenaRegistro">
       <property name="echoMode"><enum>QLineEdit::Password</enum></property>
      </widget>
     </item>
     <item row="8" column="0">
      <widget class="QLabel" name="labelSucursal"><property name="text"><string>Sucursal de este equipo:</string></property></widget>
     </item>
     <item row="8" column="1">
      <layout class="QHBoxLayout" name="sucursalLayout">
       <item><widget class="QComboBox" name="comboSucursal"/></item>
       <item><widget class="QPushButton" name="btnConsultar"><property name="text"><string>Consultar</string></property></widget></item>
      </layout>
     </item>
    </layout>
   </item>
   <item>
    <widget class="QLabel" name="labelAyudaFuncion">
     <property name="wordWrap"><bool>true</bool></property>
     <property name="text"><string/></property>
    </widget>
   </item>
   <item>
    <widget class="QLabel" name="labelError">
     <property name="text"><string/></property>
     <property name="wordWrap"><bool>true</bool></property>
    </widget>
   </item>
   <item>
    <layout class="QHBoxLayout" name="botonesLayout">
     <item>
      <spacer name="spacer"><property name="orientation"><enum>Qt::Horizontal</enum></property></spacer>
     </item>
     <item>
      <widget class="QPushButton" name="btnCancelar">
       <property name="text"><string>Cancelar</string></property>
      </widget>
     </item>
     <item>
      <widget class="QPushButton" name="btnConfigurar">
       <property name="text"><string>Configurar</string></property>
       <property name="default"><bool>true</bool></property>
      </widget>
     </item>
    </layout>
   </item>
  </layout>
 </widget>
</ui>
