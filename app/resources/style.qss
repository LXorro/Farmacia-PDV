/* ============================================================
   Farmacia — hoja de estilos global (paleta, tipografía, widgets)
   ============================================================ */

* {
    font-family: "Noto Sans", "Segoe UI", sans-serif;
}

QWidget {
    background: #f3f5f6;
    color: #222831;
    font-size: 14px;
}

QLabel {
    background: transparent;
}

QMainWindow, QStackedWidget, QDialog {
    background: #f3f5f6;
}

QToolTip {
    background: #222831;
    color: #ffffff;
    border: none;
    padding: 4px 8px;
}

/* ---------- Barra de título personalizada (sin marco del sistema) ---------- */
QWidget#barraTitulo {
    background: #16252b;
}
QLabel#labelTituloApp {
    background: transparent;
    color: #cfd8dc;
    font-size: 12px;
}
QPushButton#btnMinimizar, QPushButton#btnCerrarApp {
    background: transparent;
    border: none;
    border-radius: 0;
    padding: 0;
}
QPushButton#btnMinimizar:hover {
    background: #1f3a40;
}
QPushButton#btnCerrarApp:hover {
    background: #c0392b;
}

/* ---------- Barra lateral de navegación ---------- */
QListWidget#listMenu {
    background: #16252b;
    border: none;
    padding: 10px 0;
    outline: 0;
    font-size: 15px;
}
QListWidget#listMenu::item {
    color: #cfd8dc;
    padding: 12px 12px;
    border-left: 3px solid transparent;
    margin: 0;
}
QListWidget#listMenu::item:selected {
    background: #1f3a40;
    color: #ffffff;
    border-left: 3px solid #1abc9c;
}
QListWidget#listMenu::item:hover:!selected {
    background: #1a2e33;
    color: #ffffff;
}

/* ---------- Tarjetas del Inicio ---------- */
QFrame#frameVentasHoy, QFrame#framePendientes, QFrame#frameCaducidad {
    background: #ffffff;
    border: 1px solid #e1e5e8;
    border-radius: 8px;
    padding: 6px;
}

/* ---------- Botones ----------
   Tres pesos para que no compitan todos: secundario (gris pizarra, el de por defecto),
   principal (acento: la acción que se espera del usuario) y destructivo (rojo).
   Los iconos son blancos, por eso los tres son de color sólido.
   OJO: un selector por nombre (QPushButton#x) le gana a QPushButton:disabled, así que cada
   variante declara también su propio :disabled. */
QPushButton {
    background: #5d7681;
    border: 1px solid #4b626c;
    border-radius: 6px;
    padding: 9px 18px;
    color: #ffffff;
    font-weight: 600;
    qproperty-iconSize: 18px 18px;
}
QPushButton:hover { background: #4b626c; }
QPushButton:pressed { background: #3d515a; }
QPushButton:disabled {
    color: #ffffff;
    background: #c5d0d5;
    border-color: #c5d0d5;
}

/* Principal: acento (también el botón por defecto de cada diálogo: Guardar, Aceptar…) */
QPushButton#btnNuevo,
QPushButton#btnCobrar,
QPushButton#btnIngresar,
QPushButton#btnConfigurar,
QPushButton#btnAgregar,
QPushButton#btnRegistrarAbono,
QPushButton#btnPdf,
QPushButton#btnCompletarReembolso,
QPushButton#btnRegistrar,
QPushButton#btnPrecioSucursal,
QPushButton#btnPuntoVenta,
QPushButton#btnProductos,
QPushButton#btnClientes,
QPushButton#btnTickets,
QPushButton#btnInventario,
QPushButton#btnCategorias,
QPushButton#btnProveedores,
QPushButton#btnEmpleados,
QPushButton#btnSucursales,
QPushButton#btnUsuarios,
QPushButton:default {
    background: #0e8c73;
    border-color: #0b7560;
}
QPushButton#btnNuevo:hover,
QPushButton#btnCobrar:hover,
QPushButton#btnIngresar:hover,
QPushButton#btnConfigurar:hover,
QPushButton#btnAgregar:hover,
QPushButton#btnRegistrarAbono:hover,
QPushButton#btnPdf:hover,
QPushButton#btnCompletarReembolso:hover,
QPushButton#btnRegistrar:hover,
QPushButton#btnPrecioSucursal:hover,
QPushButton#btnPuntoVenta:hover,
QPushButton#btnProductos:hover,
QPushButton#btnClientes:hover,
QPushButton#btnTickets:hover,
QPushButton#btnInventario:hover,
QPushButton#btnCategorias:hover,
QPushButton#btnProveedores:hover,
QPushButton#btnEmpleados:hover,
QPushButton#btnSucursales:hover,
QPushButton#btnUsuarios:hover,
QPushButton:default:hover { background: #0b7560; }
QPushButton#btnNuevo:pressed,
QPushButton#btnCobrar:pressed,
QPushButton#btnIngresar:pressed,
QPushButton#btnConfigurar:pressed,
QPushButton#btnAgregar:pressed,
QPushButton#btnRegistrarAbono:pressed,
QPushButton#btnPdf:pressed,
QPushButton#btnCompletarReembolso:pressed,
QPushButton#btnRegistrar:pressed,
QPushButton#btnPrecioSucursal:pressed,
QPushButton#btnPuntoVenta:pressed,
QPushButton#btnProductos:pressed,
QPushButton#btnClientes:pressed,
QPushButton#btnTickets:pressed,
QPushButton#btnInventario:pressed,
QPushButton#btnCategorias:pressed,
QPushButton#btnProveedores:pressed,
QPushButton#btnEmpleados:pressed,
QPushButton#btnSucursales:pressed,
QPushButton#btnUsuarios:pressed,
QPushButton:default:pressed { background: #095f4d; }
QPushButton#btnNuevo:disabled,
QPushButton#btnCobrar:disabled,
QPushButton#btnIngresar:disabled,
QPushButton#btnConfigurar:disabled,
QPushButton#btnAgregar:disabled,
QPushButton#btnRegistrarAbono:disabled,
QPushButton#btnPdf:disabled,
QPushButton#btnCompletarReembolso:disabled,
QPushButton#btnRegistrar:disabled,
QPushButton#btnPrecioSucursal:disabled,
QPushButton#btnPuntoVenta:disabled,
QPushButton#btnProductos:disabled,
QPushButton#btnClientes:disabled,
QPushButton#btnTickets:disabled,
QPushButton#btnInventario:disabled,
QPushButton#btnCategorias:disabled,
QPushButton#btnProveedores:disabled,
QPushButton#btnEmpleados:disabled,
QPushButton#btnSucursales:disabled,
QPushButton#btnUsuarios:disabled,
QPushButton:default:disabled {
    background: #a9c9c2;
    border-color: #a9c9c2;
}

/* Destructivo */
QPushButton#btnEliminar,
QPushButton#btnCancelarVenta,
QPushButton#btnRevocar {
    background: #c0392b;
    border-color: #a53224;
}
QPushButton#btnEliminar:hover,
QPushButton#btnCancelarVenta:hover,
QPushButton#btnRevocar:hover { background: #a53224; }
QPushButton#btnEliminar:pressed,
QPushButton#btnCancelarVenta:pressed,
QPushButton#btnRevocar:pressed { background: #8c2a1f; }
QPushButton#btnEliminar:disabled,
QPushButton#btnCancelarVenta:disabled,
QPushButton#btnRevocar:disabled {
    background: #e0b4ae;
    border-color: #e0b4ae;
}

/* Botones de acción principal: un poco más grandes para destacar un paso más */
QPushButton#btnCobrar, QPushButton#btnIngresar {
    font-size: 15px;
    padding: 11px 22px;
}

/* Cuadrícula de accesos rápidos del Inicio: mismo color, alineado a la izquierda */
QPushButton#btnPuntoVenta, QPushButton#btnProductos, QPushButton#btnClientes,
QPushButton#btnTickets, QPushButton#btnInventario, QPushButton#btnCategorias,
QPushButton#btnProveedores, QPushButton#btnEmpleados, QPushButton#btnSucursales,
QPushButton#btnUsuarios {
    text-align: left;
    padding-left: 18px;
    font-size: 15px;
    border-radius: 8px;
    qproperty-iconSize: 22px 22px;
}

/* ---------- Tablas ---------- */
QTableView, QTableWidget {
    background: #ffffff;
    alternate-background-color: #f7f9fa;
    gridline-color: #e7eaec;
    border: 1px solid #e1e5e8;
    border-radius: 6px;
    outline: 0;
    selection-background-color: #0e8c73;
    selection-color: #ffffff;
}
QHeaderView::section {
    background: #eef1f3;
    color: #222831;
    padding: 9px 10px;
    border: none;
    border-right: 1px solid #e1e5e8;
    border-bottom: 1px solid #d8dee2;
    font-weight: 600;
}
QTableView::item, QTableWidget::item {
    padding: 6px 4px;
}
QTableCornerButton::section {
    background: #eef1f3;
    border: none;
}

/* ---------- Campos de entrada ---------- */
QLineEdit, QComboBox, QSpinBox, QDoubleSpinBox, QDateEdit, QTextEdit {
    background: #ffffff;
    border: 1px solid #c7ccd1;
    border-radius: 5px;
    padding: 7px 9px;
    selection-background-color: #0e8c73;
    selection-color: #ffffff;
    min-height: 18px;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus, QDoubleSpinBox:focus,
QDateEdit:focus, QTextEdit:focus {
    border: 1px solid #0e8c73;
}
QLineEdit:disabled, QComboBox:disabled {
    background: #f3f5f6;
    color: #9aa1a6;
}

/* ---------- Totales y etiquetas destacadas ---------- */
QLabel#labelTotal {
    color: #0e8c73;
    font-size: 22px;
    font-weight: 700;
}
QLabel#labelError {
    color: #c0392b;
}

/* ---------- Listas desplegables ---------- */
QComboBox QAbstractItemView {
    background: #ffffff;
    border: 1px solid #c7ccd1;
    selection-background-color: #0e8c73;
    selection-color: #ffffff;
}

/* ---------- Flechas de combos, fechas y spinboxes ---------- */
QComboBox::drop-down, QDateEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    width: 26px;
    border: none;
}
QComboBox::down-arrow, QDateEdit::down-arrow {
    image: url(:/ui/chevron-down.svg);
    width: 14px;
    height: 14px;
}
QSpinBox::up-button, QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 22px;
    border: none;
    background: transparent;
}
QSpinBox::down-button, QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 22px;
    border: none;
    background: transparent;
}
QSpinBox::up-arrow, QDoubleSpinBox::up-arrow {
    image: url(:/ui/chevron-up.svg);
    width: 12px;
    height: 12px;
}
QSpinBox::down-arrow, QDoubleSpinBox::down-arrow {
    image: url(:/ui/chevron-down.svg);
    width: 12px;
    height: 12px;
}

/* ---------- Encabezado de cada pantalla ---------- */
QWidget#encabezadoPagina {
    background: #f3f5f6;
    border-bottom: 1px solid #e1e5e8;
}
QLabel#labelTituloPagina {
    color: #16252b;
    font-size: 22px;
    font-weight: 700;
}
QLabel#labelSubtituloPagina {
    color: #6b7780;
    font-size: 13px;
}

/* ---------- Secciones del menú lateral (elementos no seleccionables) ---------- */
QListWidget#listMenu::item:disabled {
    background: transparent;
    color: #6f8a92;
    padding: 14px 12px 4px 15px;
    border-left: 3px solid transparent;
}

/* ---------- Insignia de sesión en la barra superior ---------- */
QLabel#labelInsignia {
    background: transparent;
    color: #cfd8dc;
    font-size: 12px;
    padding-right: 12px;
}

/* Barra de desplazamiento del menú lateral: fina y oscura, no la clara del estilo por defecto */
QListWidget#listMenu QScrollBar:vertical {
    background: transparent;
    width: 8px;
    margin: 0;
}
QListWidget#listMenu QScrollBar::handle:vertical {
    background: #35505a;
    border-radius: 4px;
    min-height: 24px;
}
QListWidget#listMenu QScrollBar::add-line:vertical, QListWidget#listMenu QScrollBar::sub-line:vertical {
    height: 0;
}
QListWidget#listMenu QScrollBar::add-page:vertical, QListWidget#listMenu QScrollBar::sub-page:vertical {
    background: transparent;
}
